# Backend only. Source this file in the shell that starts the backend.
DATABENTO_API_KEY=
# Hard maximum is $5; lower values are accepted. Never reset the persisted ledger to retry.
DATABENTO_TEST_BUDGET_USD=5
# Fill these from current portal evidence. Do not assume the original credits are still valid.
DATABENTO_CREDITS_USD=
DATABENTO_CREDITS_VERIFIED_AT=
DATABENTO_CREDITS_EXPIRE_AT=
# Optional absolute directories outside the repository; keep cache and durable storage separate.
# FOREXTESTER_CACHE_DIR=/absolute/cache/root
# FOREXTESTER_DATA_DIR=/absolute/backtests
