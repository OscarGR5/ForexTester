// Offline Chromium verification. Durable storage, IndexedDB and Local Storage
// are isolated. No historical-data backend or provider client is constructed.
import assert from 'node:assert/strict'
import { writeFile } from 'node:fs/promises'
import { createServer } from 'vite'
import { diskApiFixture } from '../tests/diskApiFixture.js'
const { chromium } = await import(process.env.PLAYWRIGHT_MODULE ?? 'playwright-core')
const disk = await diskApiFixture()
const vite = await createServer({ configFile: false, root: 'frontend', cacheDir: `${disk.directory}/vite`,
  optimizeDeps: { include: ['react', 'react-dom/client', 'lightweight-charts', 'technicalindicators'] },
  server: { watch: null, hmr: false, host: '127.0.0.1', port: 5198, strictPort: true, proxy: { '/api': { target: disk.origin, changeOrigin: false } } } })
await vite.listen()
const browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH ?? '/home/admin/.cache/ms-playwright/chromium-1248/chrome-linux64/chrome', chromiumSandbox: true })
const context = await browser.newContext({ viewport: { width: 1440, height: 900 } })
const report = { checks: [] as string[], screenshots: [] as string[], errors: [] as string[], historyRequests: [] as string[], paidCalls: 0 }
await context.addInitScript('globalThis.__name = target => target')
await context.route('**/api/history/**', route => {
  report.historyRequests.push(new URL(route.request().url()).pathname)
  assert.ok(route.request().url().endsWith('/coverage'), 'Only mocked coverage may be requested')
  return route.fulfill({ json: { symbol: '6E', resolution: 'M1', cachedDates: 0, cachedFrom: null, cachedTo: null, latestEligibleDate: '2024-03-30', providerHealth: { status: 'unavailable' } } })
})
const page = await context.newPage()
page.on('pageerror', error => report.errors.push(error.message))
async function screenshot(name: string) { const path = `docs/session-startup/${name}.png`; await page.screenshot({ path, fullPage: true }); report.screenshots.push(path) }
async function seed(name: string, legacy = false) {
  return page.evaluate(async ({ name, legacy }) => {
    const { DiskSessionStore } = await import('/src/diskSessionStore.ts')
    const { SessionStore } = await import('/src/sessionStore.ts')
    const { sessionHistory, sessionSimulation } = await import('/src/sessionFixtures.ts')
    const { historyFingerprint } = await import('/src/sessionCodec.ts')
    const store = legacy ? new SessionStore() : new DiskSessionStore(), history = sessionHistory(), sim = sessionSimulation(history)
    sim.observe(89)
    const historyId = await historyFingerprint(history)
    await store.cacheHistory(historyId, history)
    const record = await store.save({ id: crypto.randomUUID(), name, createdAt: new Date().toISOString(), range: { from: history.tradingFrom, to: history.to }, historyId, totalCandles: history.bid.length }, sim.snapshot(), null)
    if (legacy) await store.close()
    return record
  }, { name, legacy })
}
try {
  await page.goto('http://127.0.0.1:5198')
  await page.getByRole('region', { name: 'Backtest setup', exact: true }).waitFor()
  assert.equal(await page.locator('.startup-selection').count(), 0)
  report.checks.push('Empty disk opens Setup')
  const saved = await seed('EURUSD Strategy — January 2024')
  const legacy = await seed('Legacy browser research', true)
  await page.reload()
  await page.getByRole('heading', { name: 'Choose a backtest', exact: true }).waitFor()
  assert.equal(await page.locator('dialog').count(), 0)
  assert.equal(await page.locator('.startup-selection .saved-session').count(), 1)
  assert.equal(await page.evaluate(() => document.activeElement?.textContent), 'Choose a backtest')
  const rect = await page.locator('.startup-selection .session-controls').boundingBox()
  assert.ok(rect && rect.width >= 650 && rect.width <= 800 && Math.abs(rect.x + rect.width / 2 - 720) <= 2)
  const area = await page.locator('.startup-selection').boundingBox()
  assert.ok(area && Math.abs(rect.y + rect.height / 2 - (area.y + area.height / 2)) <= 2)
  await page.keyboard.press('Tab')
  assert.equal(await page.evaluate(() => document.activeElement?.textContent), 'Resume backtest')
  assert.equal(await page.evaluate(() => getComputedStyle(document.activeElement!).outlineStyle), 'solid')
  await screenshot('startup-single-1440')
  report.checks.push('One saved session opens centered 740px selector with heading focus and visible keyboard focus')
  for (const name of ['London session — February 2024', 'New York continuation', 'Risk model comparison', 'Breakout study', 'End-of-month review']) await seed(name)
  await page.reload(); await page.getByRole('heading', { name: 'Choose a backtest', exact: true }).waitFor()
  for (const width of [1440, 390]) {
    await page.setViewportSize({ width, height: width === 390 ? 844 : 900 })
    assert.equal(await page.locator('.startup-selection .saved-session').count(), 6)
    assert.equal(await page.evaluate(() => document.documentElement.scrollWidth), width)
    const list = page.locator('.startup-selection .saved-sessions')
    assert.ok(await list.evaluate(node => node.scrollHeight > node.clientHeight))
    await list.evaluate(node => { node.scrollTop = node.scrollHeight })
    assert.ok(await list.evaluate(node => node.scrollTop > 0))
    await list.evaluate(node => { node.scrollTop = 0 })
    await screenshot(`startup-${width}`)
  }
  report.checks.push('Six sessions render with scrollable list and no horizontal overflow at 1440px and 390px')
  await page.setViewportSize({ width: 1440, height: 900 })
  await page.locator('.saved-session').filter({ hasText: 'EURUSD Strategy — January 2024' }).getByRole('button', { name: 'Resume backtest', exact: true }).click()
  await page.locator('.phase-trading').waitFor()
  await page.getByRole('button', { name: 'Sessions / settings', exact: true }).click()
  await page.getByRole('button', { name: 'Save now', exact: true }).click()
  await page.waitForFunction(() => document.querySelector('.save-state')?.textContent === 'Saved')
  const resumed = (await disk.storage.list()).sessions.find(row => row.id === saved.id)!
  assert.deepEqual(resumed.checkpoint.trading, saved.checkpoint.trading)
  assert.deepEqual(resumed.checkpoint.equity, saved.checkpoint.equity)
  assert.equal(resumed.checkpoint.replay.index, saved.checkpoint.replay.index)
  const dialog = await page.locator('dialog.management-dialog').boundingBox()
  assert.ok(dialog && dialog.x > 500 && Math.abs(dialog.x + dialog.width - 1424) <= 2)
  await screenshot('management-trading-1440')
  await page.setViewportSize({ width: 390, height: 844 })
  assert.equal(await page.evaluate(() => document.documentElement.scrollWidth), 390)
  await screenshot('management-trading-390')
  report.checks.push('Resume restores trading, replay index and equity; ordinary management opens right-side native dialog')
  const beforeNewKeys = await page.evaluate(() => Object.keys(localStorage))
  await page.getByRole('button', { name: 'New session', exact: true }).click()
  await page.getByRole('region', { name: 'Backtest setup', exact: true }).waitFor()
  assert.equal((await disk.storage.list()).sessions.length, 6)
  const activeKey = (await page.evaluate(() => Object.keys(localStorage))).find(key => !beforeNewKeys.includes(key))!
  assert.ok(activeKey)
  // Reset only this isolated test profile's earlier abandoned Setup preferences.
  await page.evaluate(activeKey => { for (const key of Object.keys(localStorage)) if (key !== activeKey) localStorage.removeItem(key) }, activeKey)
  await page.evaluate(({ savedId, legacyId }) => {
    for (const id of [savedId, legacyId, 'orphan']) localStorage.setItem(`forextester:ui:v1:${id}`, 'keep')
    localStorage.setItem('unrelated', 'keep')
  }, { savedId: saved.id, legacyId: legacy.id })
  const protectedKeys = await page.evaluate(() => Object.keys(localStorage).filter(key => !key.endsWith(':orphan')))
  await page.getByRole('button', { name: 'Sessions / settings', exact: true }).click()
  await page.getByText('Storage maintenance', { exact: true }).click()
  await page.getByRole('button', { name: 'Clean up unused UI preferences', exact: true }).click()
  await page.getByText('1 unused UI preference entries safe to remove.', { exact: true }).waitFor()
  page.once('dialog', dialog => dialog.dismiss())
  await page.getByRole('button', { name: 'Confirm UI preference cleanup', exact: true }).click()
  assert.equal(await page.evaluate(() => localStorage.getItem('forextester:ui:v1:orphan')), 'keep')
  page.once('dialog', dialog => dialog.accept())
  await page.getByRole('button', { name: 'Confirm UI preference cleanup', exact: true }).click()
  await page.getByText('Removed 1 UI preference entries.', { exact: true }).waitFor()
  assert.equal(await page.evaluate(() => localStorage.getItem('forextester:ui:v1:orphan')), null)
  assert.deepEqual(await page.evaluate(() => Object.keys(localStorage).sort()), protectedKeys.sort())
  await page.getByRole('button', { name: 'Clean up unused UI preferences', exact: true }).click()
  await page.getByText('0 unused UI preference entries safe to remove.', { exact: true }).waitFor()
  report.checks.push('New preserves all saved sessions; confirmation is required; cleanup retains saved, legacy, active and unrelated preferences; repeat preview is empty')
  const other = await context.newPage()
  await other.goto('http://127.0.0.1:5198'); await other.getByRole('button', { name: 'New backtest', exact: true }).click()
  await other.getByRole('region', { name: 'Backtest setup', exact: true }).waitFor()
  await page.evaluate(() => localStorage.setItem('forextester:ui:v1:uncertain', 'keep'))
  await page.getByRole('button', { name: 'Clean up unused UI preferences', exact: true }).click()
  await page.getByText(/could not verify other tabs/).waitFor()
  assert.equal(await page.evaluate(() => localStorage.getItem('forextester:ui:v1:uncertain')), 'keep')
  await other.close()
  report.checks.push('A second tab with an unsaved session prevents cleanup')
  await context.route('**/api/storage/sessions', route => route.fulfill({ status: 503, json: { error: 'Inventory unavailable' } }))
  await page.getByRole('button', { name: 'Clean up unused UI preferences', exact: true }).click()
  await page.getByText('Inventory unavailable', { exact: true }).waitFor()
  assert.equal(await page.evaluate(() => localStorage.getItem('forextester:ui:v1:uncertain')), 'keep')
  await context.unroute('**/api/storage/sessions')
  report.checks.push('Unavailable disk inventory retains uncertain preferences')
  // Verify the deletion path in real Chromium with its real shared/exclusive leases.
  await page.getByRole('button', { name: 'Resume / Manage sessions', exact: true }).click()
  const target = page.locator('.saved-session').filter({ hasText: 'Risk model comparison' })
  const targetRecord = (await disk.storage.list()).sessions.find(row => row.name === 'Risk model comparison')!
  await page.evaluate(id => localStorage.setItem(`forextester:ui:v1:${id}`, 'delete-me'), targetRecord.id)
  page.once('dialog', dialog => dialog.accept())
  await target.getByRole('button', { name: 'Delete', exact: true }).click()
  await target.waitFor({ state: 'detached' })
  assert.equal(await page.evaluate(id => localStorage.getItem(`forextester:ui:v1:${id}`), targetRecord.id), null)
  report.checks.push('Confirmed disk deletion removes only its UI key with real Web Locks')
  assert.deepEqual(report.errors, [])
  await writeFile('docs/session-startup/browser-verification.json', JSON.stringify(report, null, 2) + '\n')
  console.log(JSON.stringify(report, null, 2))
} catch (error) { console.error(await page.locator('body').innerText()); throw error } finally { await browser.close(); await vite.close(); await disk.close() }
